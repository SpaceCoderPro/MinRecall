<Page
    x:Class="MinRecall.UI.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MinRecall.UI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Activity Log"
                   Style="{StaticResource HeaderTextBlockStyle}"
                   Margin="24,20,0,12"/>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,0,16">
            <CalendarDatePicker x:Name="StartDatePicker"
                               Header="Start Date"
                               PlaceholderText="Choose start date"
                               DateChanged="DatePicker_DateChanged"
                               Width="200"/>

            <CalendarDatePicker x:Name="EndDatePicker"
                               Header="End Date"
                               PlaceholderText="Choose end date"
                               DateChanged="DatePicker_DateChanged"
                               Width="200"
                               Margin="12,0,0,0"/>

            <ComboBox x:Name="FilterComboBox"
                      Header="Filter by App"
                      Width="200"
                      Margin="12,0,0,0"
                      SelectionChanged="FilterComboBox_SelectionChanged">
                <ComboBoxItem Tag="" IsSelected="True">All Apps</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- Activity List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ActivityItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48"
                                        Background="{ThemeResource SystemChromeMediumLowAcrylicElementMediumBrush}"
                                        CornerRadius="8">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,48,48" RadiusX="8" RadiusY="8" />
                                    </Border.Clip>
                                    <TextBlock Text="{Binding FirstLetter}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{ThemeResource TitleTextBlockStyle}"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProcessName}"
                                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                    <TextBlock Text="{Binding WindowTitle}"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding FormattedDuration}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{Binding TimeRange}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ScreenshotCount} screenshots"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
