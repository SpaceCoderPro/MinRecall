<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MinRecall.UI.Views.MainWindow"
        Title="MinRecall"
        Background="#0A0A0A"
        Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen"
        MinWidth="1200"
        MinHeight="700"
        TransparencyLevelHint="Blur">
    
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        
        <Style Selector="Button.nav-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="#888"/>
        </Style>
        
        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFF"/>
        </Style>
        
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style Selector="TextBox.search:focus">
            <Setter Property="BorderBrush" Value="#00D9FF"/>
        </Style>
    </Window.Styles>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0D0D0D" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20">
                <!-- Logo -->
                <StackPanel Margin="20,0,20,30">
                    <TextBlock Text="MinRecall" 
                              FontSize="20" 
                              FontWeight="Bold" 
                              Foreground="#00D9FF"/>
                    <TextBlock Text="Screenshot Search" 
                              FontSize="11" 
                              Foreground="#555" 
                              Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Navigation -->
                <Button x:Name="NavTimeline" Classes="nav-btn active" Content="Timeline" Click="NavItem_Click" Tag="timeline" Margin="10,2"/>
                <Button x:Name="NavSearch" Classes="nav-btn" Content="Search" Click="NavItem_Click" Tag="search" Margin="10,2"/>
                <Button x:Name="NavSettings" Classes="nav-btn" Content="Settings" Click="NavItem_Click" Tag="settings" Margin="10,2"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Top Bar -->
            <Border Grid.Row="0" Background="#0D0D0D" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="PageTitle" 
                              Text="Timeline" 
                              FontSize="18" 
                              FontWeight="SemiBold" 
                              Foreground="#E0E0E0"
                              VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="SearchBox" 
                                Classes="search" 
                                Watermark="Search screenshots..." 
                                Width="300"
                                KeyDown="SearchBox_KeyDown"/>
                        <Button Content="⚙" 
                               FontSize="16" 
                               Classes="nav-btn" 
                               Width="40" 
                               Height="40"
                               Click="Settings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content Area -->
            <Border x:Name="ContentFrame" Grid.Row="1" Background="#0A0A0A">
                <!-- Dynamic content loaded here -->
            </Border>
        </Grid>
    </Grid>
</Window>
