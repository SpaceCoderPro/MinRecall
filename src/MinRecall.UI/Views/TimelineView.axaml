<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:vm="using:MinRecall.UI.ViewModels"
             x:Class="MinRecall.UI.Views.TimelineView"
             x:DataType="vm:TimelineViewModel">
  
  <Design.DataContext>
    <vm:TimelineViewModel/>
  </Design.DataContext>
  
  <Grid Background="#0f0f0f">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="32,24,32,20">
      <TextBlock Text="Timeline" FontSize="28" FontWeight="Bold" Foreground="#ffffff" 
                 Margin="0,0,0,8"/>
      <TextBlock Text="Browse your screenshot history in chronological order" 
                 FontSize="14" Foreground="#888888"/>
    </StackPanel>
    
    <!-- Controls -->
    <Grid Grid.Row="1" Margin="32,0,32,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      
      <!-- Date Selector -->
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Border Background="#1a1a1a" CornerRadius="12" Padding="16,8" 
                BorderBrush="#2a2a2a" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <materialIcons:MaterialIcon Kind="Calendar" Foreground="#888888" Width="16" Height="16" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding SelectedDate}" 
                       Foreground="#ffffff" Background="Transparent" BorderThickness="0"/>
          </StackPanel>
        </Border>
        
        <!-- View Mode Selector -->
        <Border Background="#1a1a1a" CornerRadius="12" Padding="16,8" 
                BorderBrush="#2a2a2a" BorderThickness="1" Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal">
            <materialIcons:MaterialIcon Kind="ViewDashboard" Foreground="#888888" Width="16" Height="16" 
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox SelectedItem="{Binding ViewMode}" Background="Transparent" BorderThickness="0" 
                      Foreground="#ffffff">
              <ComboBoxItem Content="Hourly" Tag="hourly"/>
              <ComboBoxItem Content="Daily" Tag="daily"/>
              <ComboBoxItem Content="Weekly" Tag="weekly"/>
            </ComboBox>
          </StackPanel>
        </Border>
      </StackPanel>
      
      <!-- Timeline Scrubber -->
      <Border Grid.Column="1" Background="#1a1a1a" CornerRadius="12" Padding="24,16" 
              BorderBrush="#2a2a2a" BorderThickness="1" Margin="32,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          
          <TextBlock Grid.Row="0" Text="Timeline Scrubber" FontSize="12" FontWeight="Medium" 
                     Foreground="#888888" Margin="0,0,0,8"/>
          
          <Slider Grid.Row="1" Minimum="0" Maximum="100" Value="50" 
                  Foreground="#00d9ff" Background="#2a2a2a" 
                  IsSnapToTickEnabled="True" TickFrequency="25" 
                  TickPlacement="BottomRight"/>
        </Grid>
      </Border>
    </Grid>
    
    <!-- Timeline Content -->
    <ScrollViewer Grid.Row="2" Margin="32,0,32,32">
      <ItemsControl ItemsSource="{Binding TimelineItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" Spacing="12"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#1a1a1a" CornerRadius="16" Padding="20" 
                    BorderBrush="#2a2a2a" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="320"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Screenshot Thumbnail -->
                <Border Grid.Column="0" Width="320" Height="180" CornerRadius="12" 
                        Background="#2a2a2a">
                  <Border.Clip>
                    <RectangleGeometry Rect="0,0,320,180" RadiusX="12" RadiusY="12"/>
                  </Border.Clip>
                  <Grid>
                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" 
                           Opacity="0.8"/>
                    <Border Background="#00d9ff" CornerRadius="8" Padding="8,4" 
                            HorizontalAlignment="Left" VerticalAlignment="Top" 
                            Margin="12,12">
                      <TextBlock Text="{Binding CompressionType}" FontSize="10" 
                                 FontWeight="Bold" Foreground="#0f0f0f"/>
                    </Border>
                  </Grid>
                </Border>
                
                <!-- Content -->
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" 
                             FontSize="16" FontWeight="Bold" Foreground="#ffffff" 
                             Margin="0,0,0,4"/>
                  <TextBlock Text="{Binding ProcessName}" FontSize="14" 
                             Foreground="#00d9ff" FontWeight="Medium" Margin="0,0,0,8"/>
                  <TextBlock Text="{Binding WindowTitle}" FontSize="13" 
                             Foreground="#cccccc" TextWrapping="Wrap" MaxLines="2"/>
                  
                  <!-- Metadata -->
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <materialIcons:MaterialIcon Kind="HardDrive" Foreground="#888888" 
                                                 Width="14" Height="14"/>
                      <TextBlock Text="{Binding FileSize, StringFormat='{}{0}KB'}" 
                                 FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <materialIcons:MaterialIcon Kind="Image" Foreground="#888888" 
                                                 Width="14" Height="14"/>
                      <TextBlock Text="{Binding CompressionType}" 
                                 FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                
                <!-- Actions -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                  <Button Background="Transparent" BorderThickness="0" Padding="12" 
                          CornerRadius="8" Classes="icon-button">
                    <materialIcons:MaterialIcon Kind="Fullscreen" Foreground="#888888" 
                                               Width="20" Height="20"/>
                  </Button>
                  <Button Background="Transparent" BorderThickness="0" Padding="12" 
                          CornerRadius="8" Classes="icon-button">
                    <materialIcons:MaterialIcon Kind="Download" Foreground="#888888" 
                                               Width="20" Height="20"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    
    <!-- Loading State -->
    <Border Grid.RowSpan="3" Background="#0f0f0f" IsVisible="{Binding IsLoading}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar Width="200" Height="4" Foreground="#00d9ff" IsIndeterminate="True"/>
        <TextBlock Text="Loading timeline..." Margin="0,16,0,0" 
                   Foreground="#888888" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
  
  <UserControl.Styles>
    <Style Selector="Button.icon-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.icon-button:pointerover">
      <Setter Property="Background" Value="#2a2a2a"/>
    </Style>
  </UserControl.Styles>
</UserControl>