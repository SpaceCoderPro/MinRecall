<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MinRecall.UI.Views.TimelineView"
             Background="Transparent">
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Date Picker -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <CalendarDatePicker x:Name="DatePicker" 
                               SelectedDate="{Binding SelectedDate}" 
                               Background="#0A0A0A"
                               BorderBrush="#1A1A1A"
                               Foreground="#FFF"
                               CornerRadius="8"/>
            <TextBlock Text="{Binding StatusMessage}" 
                      Foreground="#666" 
                      FontSize="13"
                      VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Screenshots Grid -->
        <ScrollViewer Grid.Row="1" 
                     HorizontalScrollBarVisibility="Disabled" 
                     VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ScreenshotGrid" ItemsSource="{Binding TimelineItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0A0A0A" 
                               BorderBrush="#1A1A1A"
                               BorderThickness="1"
                               CornerRadius="12" 
                               Margin="8"
                               Width="320"
                               Height="240"
                               Cursor="Hand"
                               Classes="screenshot-card">
                            <Border.Styles>
                                <Style Selector="Border.screenshot-card">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                                <Style Selector="Border.screenshot-card:pointerover">
                                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                                    <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                </Style>
                            </Border.Styles>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Screenshot Image -->
                                <Border Grid.Row="0" Background="#000" CornerRadius="12,12,0,0" ClipToBounds="True">
                                    <Panel>
                                        <!-- Image -->
                                        <Image Source="{Binding FilePath}" 
                                              Stretch="UniformToFill"
                                              IsVisible="{Binding !!FilePath}"/>
                                        
                                        <!-- Placeholder if no image -->
                                        <TextBlock Text="📷" 
                                                  FontSize="48" 
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="#333"
                                                  IsVisible="{Binding !FilePath}"/>
                                    </Panel>
                                </Border>
                                
                                <!-- Info -->
                                <StackPanel Grid.Row="1" Margin="12,10" Spacing="4">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                                              FontSize="14" 
                                              Foreground="#00E5FF"
                                              FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding WindowTitle}" 
                                              FontSize="12" 
                                              Foreground="#AAA"
                                              TextTrimming="CharacterEllipsis"
                                              MaxLines="1"/>
                                    <TextBlock Text="{Binding ProcessName}" 
                                              FontSize="11" 
                                              Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Empty State -->
        <StackPanel Grid.Row="1" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Spacing="16"
                   IsVisible="{Binding !TimelineItems.Count}">
            <TextBlock Text="📸" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
            <TextBlock Text="No screenshots yet" 
                      FontSize="18" 
                      Foreground="#666"
                      HorizontalAlignment="Center"
                      FontWeight="Medium"/>
            <TextBlock Text="Start the capture service to begin recording" 
                      FontSize="13" 
                      Foreground="#444"
                      HorizontalAlignment="Center"/>
            <Button Content="Open Settings" 
                   Background="#00E5FF"
                   Foreground="#000"
                   BorderThickness="0"
                   Padding="16,8"
                   CornerRadius="8"
                   FontSize="13"
                   Cursor="Hand"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
