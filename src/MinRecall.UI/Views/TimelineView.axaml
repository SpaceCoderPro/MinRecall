<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MinRecall.UI.Views.TimelineView"
             Background="Transparent">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Date Picker -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
            <CalendarDatePicker x:Name="DatePicker" 
                               SelectedDate="{Binding SelectedDate}" 
                               Background="#1A1A1A"
                               BorderBrush="#2A2A2A"
                               Foreground="#E0E0E0"/>
            <TextBlock Text="{Binding StatusMessage}" 
                      Foreground="#888" 
                      VerticalAlignment="Center"
                      FontSize="13"/>
        </StackPanel>
        
        <!-- Screenshots Grid -->
        <ScrollViewer Grid.Row="1" 
                     HorizontalScrollBarVisibility="Disabled" 
                     VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ScreenshotGrid" ItemsSource="{Binding TimelineItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#111" 
                               CornerRadius="8" 
                               Margin="8"
                               Width="280"
                               Height="180"
                               Cursor="Hand"
                               Classes="screenshot-card">
                            <Border.Styles>
                                <Style Selector="Border.screenshot-card:pointerover">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                </Style>
                            </Border.Styles>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Screenshot Image -->
                                <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <Image Source="{Binding FilePath}" 
                                          Stretch="UniformToFill"/>
                                </Border>
                                
                                <!-- Info -->
                                <StackPanel Grid.Row="1" Margin="12" Spacing="4">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                                              FontSize="12" 
                                              Foreground="#00D9FF"
                                              FontWeight="Medium"/>
                                    <TextBlock Text="{Binding WindowTitle}" 
                                              FontSize="11" 
                                              Foreground="#888"
                                              TextTrimming="CharacterEllipsis"
                                              MaxLines="1"/>
                                    <TextBlock Text="{Binding ProcessName}" 
                                              FontSize="10" 
                                              Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Empty State -->
        <StackPanel Grid.Row="1" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Spacing="12"
                   IsVisible="{Binding !TimelineItems.Count}">
            <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="No screenshots yet" 
                      FontSize="16" 
                      Foreground="#888"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="Screenshots will appear here once the capture service is running" 
                      FontSize="12" 
                      Foreground="#666"
                      HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
