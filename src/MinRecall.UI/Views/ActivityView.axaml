<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:vm="using:MinRecall.UI.ViewModels"
             xmlns:local="using:MinRecall.UI.Converters"
             x:Class="MinRecall.UI.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
  
  <Design.DataContext>
    <vm:ActivityViewModel/>
  </Design.DataContext>
  
  <Grid Background="#0f0f0f">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="32,24,32,20">
      <TextBlock Text="Activity Log" FontSize="28" FontWeight="Bold" Foreground="#ffffff" 
                 Margin="0,0,0,8"/>
      <TextBlock Text="Track your application usage and activity patterns" 
                 FontSize="14" Foreground="#888888"/>
    </StackPanel>
    
    <!-- Controls and Stats -->
    <Grid Grid.Row="1" Margin="32,0,32,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      
      <!-- Date Selector -->
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Border Background="#1a1a1a" CornerRadius="12" Padding="16,8" 
                BorderBrush="#2a2a2a" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <materialIcons:MaterialIcon Kind="Calendar" Foreground="#888888" Width="16" Height="16" 
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding SelectedDate}" 
                       Foreground="#ffffff" Background="Transparent" BorderThickness="0"/>
          </StackPanel>
        </Border>
      </StackPanel>
      
      <!-- Summary Stats -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
        <Border Background="#1a1a1a" CornerRadius="16" Padding="20,16" 
                BorderBrush="#2a2a2a" BorderThickness="1" MinWidth="140">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding TotalActivities}" FontSize="20" FontWeight="Bold" 
                       Foreground="#00d9ff" HorizontalAlignment="Center"/>
            <TextBlock Text="Activities" FontSize="11" Foreground="#888888" 
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        
        <Border Background="#1a1a1a" CornerRadius="16" Padding="20,16" 
                BorderBrush="#2a2a2a" BorderThickness="1" MinWidth="140">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding TotalActiveTime, StringFormat='{}{0:hh\\:mm}'}" 
                       FontSize="20" FontWeight="Bold" Foreground="#00ff88" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Active Time" FontSize="11" Foreground="#888888" 
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        
        <Border Background="#1a1a1a" CornerRadius="16" Padding="20,16" 
                BorderBrush="#2a2a2a" BorderThickness="1" MinWidth="140">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding MostUsedApplication}" FontSize="14" FontWeight="Bold" 
                       Foreground="#ff6b6b" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="Top App" FontSize="11" Foreground="#888888" 
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
      
      <!-- View Controls -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Background="#00d9ff" BorderThickness="0" Padding="12,8" CornerRadius="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="FormatListBulleted" Foreground="#0f0f0f" Width="16" Height="16"/>
            <TextBlock Text="List" Foreground="#0f0f0f" FontSize="12" FontWeight="Medium"/>
          </StackPanel>
        </Button>
        <Button Background="#2a2a2a" BorderThickness="0" Padding="12,8" CornerRadius="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="ViewGrid" Foreground="#888888" Width="16" Height="16"/>
            <TextBlock Text="Grid" Foreground="#888888" FontSize="12"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    
    <!-- Activity Timeline -->
    <ScrollViewer Grid.Row="2" Margin="32,0,32,32">
      <StackPanel Spacing="12">
        
        <!-- Timeline Header -->
        <Border Background="#1a1a1a" CornerRadius="12" Padding="20,16" 
                BorderBrush="#2a2a2a" BorderThickness="1" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <materialIcons:MaterialIcon Kind="Timeline" Foreground="#00d9ff" Width="24" Height="24" 
                                      VerticalAlignment="Center" Grid.Column="0" Margin="0,0,16,0"/>
            
            <StackPanel Grid.Column="1">
              <TextBlock Text="Daily Activity Timeline" FontSize="16" FontWeight="Bold" 
                         Foreground="#ffffff"/>
              <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:MMMM dd, yyyy}'}" 
                         FontSize="12" Foreground="#888888"/>
            </StackPanel>
            
            <Button Grid.Column="2" Background="#2a2a2a" BorderThickness="0" Padding="12,8" CornerRadius="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <materialIcons:MaterialIcon Kind="Download" Foreground="#888888" Width="16" Height="16"/>
                <TextBlock Text="Export" Foreground="#888888" FontSize="12"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        
        <!-- Activity Items -->
        <ItemsControl ItemsSource="{Binding ActivityLog}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" Spacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#1a1a1a" CornerRadius="16" Padding="24,20" 
                      BorderBrush="#2a2a2a" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  
                  <!-- Timeline Line -->
                  <Border Grid.Column="0" Width="4" CornerRadius="2" 
                          Background="#00d9ff" Margin="0,4,16,4"/>
                  
                  <!-- Content -->
                  <StackPanel Grid.Column="1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" 
                                   FontSize="14" FontWeight="Bold" Foreground="#00d9ff" 
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProcessName}" FontSize="16" 
                                   Foreground="#ffffff" FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding WindowTitle}" FontSize="13" 
                                   Foreground="#cccccc" TextWrapping="Wrap" MaxLines="2"/>
                      </StackPanel>
                      
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" 
                                  VerticalAlignment="Top">
                        <Border Background="#2a2a2a" CornerRadius="8" Padding="8,4">
                          <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" 
                                     FontSize="10" Foreground="#888888"/>
                        </Border>
                        <materialIcons:MaterialIcon Kind="ArrowRight" Foreground="#666666" 
                                                   Width="16" Height="16" 
                                                   VerticalAlignment="Center"/>
                        <Border Background="#2a2a2a" CornerRadius="8" Padding="8,4">
                          <TextBlock Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" 
                                     FontSize="10" Foreground="#888888"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                    
                    <!-- Duration and Stats -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="Clock" Foreground="#888888" 
                                                 Width="14" Height="14"/>
                        <TextBlock Text="45m" FontSize="12" Foreground="#888888"/>
                      </StackPanel>
                      
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="Camera" Foreground="#888888" 
                                                 Width="14" Height="14"/>
                        <TextBlock Text="{Binding ScreenshotCount, StringFormat='{}{0} screenshots'}" 
                                   FontSize="12" Foreground="#888888"/>
                      </StackPanel>
                      
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="Application" Foreground="#888888" 
                                                 Width="14" Height="14"/>
                        <TextBlock Text="{Binding ProcessName}" FontSize="12" Foreground="#888888"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  
                  <!-- Actions -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                    <Button Background="Transparent" BorderThickness="0" Padding="12" 
                            CornerRadius="8" Classes="icon-button">
                      <materialIcons:MaterialIcon Kind="Fullscreen" Foreground="#888888" 
                                                 Width="20" Height="20"/>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" Padding="12" 
                            CornerRadius="8" Classes="icon-button">
                      <materialIcons:MaterialIcon Kind="Download" Foreground="#888888" 
                                                 Width="20" Height="20"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    
    <!-- Loading State -->
    <Border Grid.RowSpan="3" Background="#0f0f0f80" IsVisible="{Binding IsLoading}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar Width="200" Height="4" Foreground="#00d9ff" IsIndeterminate="True"/>
        <TextBlock Text="Loading activity data..." Margin="0,16,0,0" 
                   Foreground="#888888" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
  
  <UserControl.Styles>
    <Style Selector="Button.icon-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.icon-button:pointerover">
      <Setter Property="Background" Value="#2a2a2a"/>
    </Style>
  </UserControl.Styles>
</UserControl>