<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MinRecall.UI.Views.SearchView"
             Background="Transparent">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Search Input -->
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,20">
            <TextBox x:Name="SearchInput" 
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    Watermark="Search by text, app name, or window title..."
                    FontSize="14"
                    Padding="16,12"
                    Background="#1A1A1A"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    Foreground="#E0E0E0"
                    CornerRadius="8"
                    KeyDown="SearchInput_KeyDown"/>
            
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding ResultCount, StringFormat='{}Found {0} results'}" 
                          Foreground="#888" 
                          FontSize="13"
                          VerticalAlignment="Center"
                          IsVisible="{Binding HasSearched}"/>
                <TextBlock Text="{Binding SearchDuration, StringFormat='{}({0:F2}s)'}" 
                          Foreground="#666" 
                          FontSize="11"
                          VerticalAlignment="Center"
                          IsVisible="{Binding HasSearched}"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Loading State -->
        <StackPanel Grid.Row="1" 
                   Orientation="Horizontal" 
                   Spacing="8"
                   Margin="0,0,0,20"
                   IsVisible="{Binding IsSearching}">
            <TextBlock Text="⏳" FontSize="16"/>
            <TextBlock Text="Searching..." Foreground="#888" FontSize="13"/>
        </StackPanel>
        
        <!-- Results Grid -->
        <ScrollViewer Grid.Row="2" 
                     HorizontalScrollBarVisibility="Disabled" 
                     VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#111" 
                               CornerRadius="8" 
                               Margin="8"
                               Width="280"
                               Height="180"
                               Cursor="Hand"
                               Classes="screenshot-card">
                            <Border.Styles>
                                <Style Selector="Border.screenshot-card:pointerover">
                                    <Setter Property="Background" Value="#1A1A1A"/>
                                </Style>
                            </Border.Styles>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <Image Source="{Binding FilePath}" 
                                          Stretch="UniformToFill"/>
                                </Border>
                                
                                <StackPanel Grid.Row="1" Margin="12" Spacing="4">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:MMM dd, HH:mm:ss}'}" 
                                              FontSize="12" 
                                              Foreground="#00D9FF"
                                              FontWeight="Medium"/>
                                    <TextBlock Text="{Binding WindowTitle}" 
                                              FontSize="11" 
                                              Foreground="#888"
                                              TextTrimming="CharacterEllipsis"
                                              MaxLines="1"/>
                                    <TextBlock Text="{Binding ProcessName}" 
                                              FontSize="10" 
                                              Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Empty State -->
        <StackPanel Grid.Row="2" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Spacing="12"
                   IsVisible="{Binding !SearchResults.Count}">
            <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="No results found" 
                      FontSize="16" 
                      Foreground="#888"
                      HorizontalAlignment="Center"
                      IsVisible="{Binding HasSearched}"/>
            <TextBlock Text="Enter a search query to find screenshots" 
                      FontSize="16" 
                      Foreground="#888"
                      HorizontalAlignment="Center"
                      IsVisible="{Binding !HasSearched}"/>
        </StackPanel>
    </Grid>
</UserControl>
