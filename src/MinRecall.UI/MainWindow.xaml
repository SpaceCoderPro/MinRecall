<Window
    x:Class="MinRecall.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MinRecall.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid x:Name="TitleBar" Background="{ThemeResource SystemChromeMediumLowAcrylicElementMediumBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource NavigationBackButtonNormalStyle}"
                    Margin="8,8,0,8" Click="BackButton_Click"/>

            <TextBlock x:Name="AppTitle" Grid.Column="1"
                       Text="MinRecall"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       Style="{ThemeResource TitleTextBlockStyle}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,8">
                <Button x:Name="SettingsButton" Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation View -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        ItemInvoked="NavView_ItemInvoked"
                        Loaded="NavView_Loaded"
                        Canvas.ZIndex="0">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Clock" Content="Timeline" Tag="timeline"/>
                <NavigationViewItem Icon="Globe" Content="Search" Tag="search"/>
                <NavigationViewItem Icon="View" Content="Activity Heatmap" Tag="heatmap"/>
                <NavigationViewItem Icon="List" Content="Activity Log" Tag="activity"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
